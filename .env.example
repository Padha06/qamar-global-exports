# Public site URL used for canonical URLs, Open Graph tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.qamarglobalexports.com

# Optional: server-side endpoint that receives website enquiries as JSON.
# Point at Formspree / a CRM / Zapier / Make / n8n / your own API.
# Until this is set, enquiry delivery is inactive and the RFQ form offers a
# WhatsApp / email fallback (never a false success).
# ENQUIRY_WEBHOOK_URL=https://example.com/hooks/qamar-enquiry
